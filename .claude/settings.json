{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/pavel.pisetski/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/pavel.pisetski/.npm-global/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/local/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/pavel.pisetski/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/pavel.pisetski/.npm-global/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/usr/local/bin/node'",
